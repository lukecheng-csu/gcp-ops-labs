global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'host', 'app']
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 4h
  receiver: lab08-email

receivers:
  - name: lab08-email
    email_configs:
      - to: '__ALERT_EMAIL__'
        from: '__ALERT_FROM__'
        smarthost: '__SMTP_HOST__'
        auth_username: '__ALERT_FROM__'
        auth_password: '__SMTP_PASSWORD__'
        require_tls: __SMTP_REQUIRE_TLS__
        send_resolved: true

# 说明：默认占位值不会真的发出邮件，但 Alertmanager 能正常启动、正常收告警、正常显示 resolved。
# 想真收邮件：填 SMTP 授权码后重跑 render.sh 并 docker compose restart alertmanager。
# GCP 注意：GCE 封禁出站 TCP 25（2026-11-13 实测 163/QQ 的 25 端口都不通），
# 163 SMTP 只有 25(STARTTLS)/465(隐式TLS) 两条路，Alertmanager 都用不了；
# 用 QQ SMTP 的 587 端口（STARTTLS 实测通）：
#   ALERT_EMAIL='收件人@163.com' ALERT_FROM='发件人@qq.com' SMTP_HOST='smtp.qq.com:587'
#   SMTP_REQUIRE_TLS=true SMTP_PASSWORD='<QQ授权码>' bash scripts/render.sh
# 不发邮件也不影响练习：告警状态在 Prometheus /alerts、Alertmanager UI、Grafana 看板里都能看。
