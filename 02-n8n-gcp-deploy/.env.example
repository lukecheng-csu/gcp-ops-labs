# === 练习 2 环境变量 ===
# 用法：cp .env.example .env 然后逐项填好。docker compose 会自动读同目录 .env。

# 对外域名（先到 DNS 供应商加 A 记录指向 VM 外网 IP）
N8N_HOST=n8n-gcp.cloudworkflowdone.com

# PostgreSQL 连接（用户名/库名保持默认，只改密码）
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# n8n 凭证加密密钥：openssl rand -hex 24 生成，一次定下后不要改（改了旧凭证全废）
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_24
